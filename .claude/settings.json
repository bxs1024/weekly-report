{
  "permissions": {
    "allow": [
      "Edit(scripts/*.py)",
      "Write(scripts/*.py)",
      "Edit(.github/workflows/*.yml)",
      "Write(.github/workflows/*.yml)",
      "Edit(scripts/template.html)",
      "Write(scripts/template.html)",
      "Read",
      "Glob",
      "Grep",
      "Bash(python scripts/*.py)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git remote *)",
      "Bash(git config *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/16120/AppData/Local/Python/bin/python scripts/hook_check.py",
            "timeout": 15,
            "statusMessage": "检查改动文件语法..."
          }
        ]
      }
    ]
  }
}
